LOCAL_DATABASE_PATH=./data/fluxo.sqlite
BETTER_AUTH_URL=http://localhost:4175
BETTER_AUTH_SECRET=gere-um-segredo-com-pelo-menos-32-caracteres

# Em produção, DATABASE_URL ativa PostgreSQL no lugar do SQLite.
# DATABASE_URL=postgresql://usuario:senha@postgres:5432/fluxo

SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario
SMTP_PASS=senha
EMAIL_FROM=Fluxo <tarefas@exemplo.com>
EMAIL_POLL_INTERVAL_MS=15000
